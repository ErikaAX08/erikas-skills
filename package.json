{
  "name": "erikas-skills",
  "version": "0.1.0",
  "description": "Reusable skills collection for consistent code generation with Claude Code, Copilot, Cursor and other assistants — frontend architecture, API standards, Spec Kit, orchestration and quality.",
  "keywords": [
    "claude-code",
    "opencode",
    "skills",
    "ai",
    "spec-kit",
    "frontend-architecture",
    "copilot",
    "cursor"
  ],
  "license": "Apache-2.0",
  "author": "ErikaAX08 <eamastalxochimitl@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErikaAX08/erikas-skills.git"
  },
  "homepage": "https://github.com/ErikaAX08/erikas-skills#readme",
  "bugs": {
    "url": "https://github.com/ErikaAX08/erikas-skills/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "files": [
    "backend-api-standards/**/*",
    "brain-orchestrator/**/*",
    "code-architecture-explainer/**/*",
    "code-documentation/**/*",
    "create-pull-request/**/*",
    "frontend-architecture/**/*",
    "frontend-design/**/*",
    "git-commits/**/*",
    "latex-academic-reports/**/*",
    "pre-pr-review/**/*",
    "project-intelligence/**/*",
    "project-setup/**/*",
    "spec-kit/**/*",
    "spec-kit-*/**/*",
    "verify-before-implement/**/*",
    "brand-guidelines/**/*",
    "bin/**/*",
    "scripts/**/*",
    "NOTICE"
  ],
  "bin": {
    "erikas-skills": "./bin/cli.mjs"
  },
  "scripts": {
    "install:skills": "node ./scripts/install.mjs",
    "validate": "node ./scripts/validate.mjs",
    "sync:versions": "node ./scripts/sync-versions.mjs",
    "test": "node ./scripts/validate.mjs && pnpm run test:spec-kit && pnpm run test:pre-pr-review",
    "test:spec-kit": "node --test spec-kit-shared/scripts/test/scripts.test.mjs spec-kit-shared/scripts/test/runlog.test.mjs scripts/test/check-references.test.mjs",
    "test:pre-pr-review": "node --test pre-pr-review/scripts/test/scripts.test.mjs pre-pr-review/evals/test/harness.test.mjs"
  }
}
